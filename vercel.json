{
  "version": 2,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|_build/|favicon.ico|robots.txt|sitemap.xml|.*\\..*).+)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
